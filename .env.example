# --- Provider keys: only needed to chat *inside* Anamnesis (the shared memory works without them) ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Optional: model overrides (LiteLLM model strings) ---
# ANAMNESIS_CLAUDE_MODEL=anthropic/claude-sonnet-5-5
# ANAMNESIS_GEMINI_MODEL=gemini/gemini-3.8-flash
# ANAMNESIS_DEFAULT_MODEL=claude
# ANAMNESIS_REQUEST_TIMEOUT=120              # seconds per provider request
# ANAMNESIS_MAX_RETRIES=2                    # retries on transient provider errors (429/5xx)

# --- Optional: storage & memory ---
# ANAMNESIS_DATA_DIR=~/.anamnesis            # SQLite db, vector index, embedding model cache, logs
# ANAMNESIS_RAG=true                         # inject relevant past snippets into prompts
# ANAMNESIS_RAG_TOP_K=4
# ANAMNESIS_RAG_MIN_SCORE=0.6                # cosine similarity threshold for injected snippets
# ANAMNESIS_HISTORY_LIMIT=40                 # recent messages sent with each prompt
# ANAMNESIS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# ANAMNESIS_MEMORY_SYNC=true                 # import Claude Code / Codex / Gemini CLI / Cursor history in the background
# ANAMNESIS_MEMORY_SYNC_INTERVAL=60          # seconds between background imports

# --- Optional: web server ---
# ANAMNESIS_HOST=127.0.0.1                   # use 0.0.0.0 to reach it from other devices…
# ANAMNESIS_PORT=8000
# ANAMNESIS_ALLOWED_HOSTS=my-laptop.local,192.168.1.20   # …and list the hostnames you'll use
# ANAMNESIS_AUTH_TOKEN=                      # strongly recommended when not on localhost; open http://host:8000/?token=…
