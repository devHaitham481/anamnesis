# --- Provider keys (required for the models you use) ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Optional: model overrides (LiteLLM model strings) ---
# NEXUS_CLAUDE_MODEL=anthropic/claude-sonnet-5-5
# NEXUS_GEMINI_MODEL=gemini/gemini-2.5-flash
# NEXUS_DEFAULT_MODEL=claude

# --- Optional: storage & memory ---
# NEXUS_DATA_DIR=~/.nexus-ai            # SQLite db, vector index, embedding model cache, logs
# NEXUS_RAG=true                         # inject relevant past snippets into prompts
# NEXUS_RAG_TOP_K=4
# NEXUS_RAG_MIN_SCORE=0.6                # cosine similarity threshold for injected snippets
# NEXUS_HISTORY_LIMIT=40                 # recent messages sent with each prompt
# NEXUS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Optional: web server ---
# NEXUS_HOST=127.0.0.1                   # use 0.0.0.0 to reach it from other devices…
# NEXUS_PORT=8000
# NEXUS_ALLOWED_HOSTS=my-laptop.local,192.168.1.20   # …and list the hostnames you'll use
# NEXUS_AUTH_TOKEN=                      # strongly recommended when not on localhost; open http://host:8000/?token=…
