Screen {
    layout: vertical;
    background: $background;
}

/* ---------- top bar: wordmark + memory stats ---------- */

#topbar {
    height: 1;
    padding: 0 2;
    margin-bottom: 1;
}

#brand {
    width: auto;
}

#status {
    width: 1fr;
    text-align: right;
    color: $text-muted;
}

/* ---------- panels ---------- */

#body {
    height: 1fr;
    padding: 0 1;
}

#sidebar {
    width: 32%;
    min-width: 28;
    max-width: 44;
    border: round $border-blurred;
    border-title-color: $text-muted;
    border-subtitle-color: $text-muted;
    background: $background;
}

#threads {
    height: 1fr;
    background: $background;
    padding: 0;
    scrollbar-size-vertical: 1;
}

#threads > ListItem {
    height: 3;
    padding: 0 1 1 1;
    background: $background;
}

#threads > ListItem.current {
    background: $panel;
}

#threads:focus > ListItem.-highlight {
    background: $primary 18%;
}

#threads > ListItem.-highlight {
    background: $panel;
}

#main {
    width: 1fr;
    margin-left: 1;
}

#prompt {
    height: 3;
    border: round $border-blurred;
    border-title-color: $text-muted;
    background: $background;
    padding: 0 1;
}

#prompt:focus {
    border: round $primary;
    border-title-color: $primary;
    background: $background;
}

#view {
    height: 1fr;
    border: round $border-blurred;
    border-title-color: $foreground;
    border-title-style: bold;
    border-subtitle-color: $text-muted;
    padding: 0 2 1 2;
    background: $background;
    scrollbar-size-vertical: 1;
}

#earlier {
    width: 100%;
    padding: 1 0 0 0;
    color: $text-muted;
    text-align: center;
}

#empty {
    width: 100%;
    padding: 2 2;
    color: $text-muted;
}

/* ---------- messages ---------- */

.message {
    height: auto;
    margin: 1 0 0 0;
    padding: 0 0 0 2;
    border-left: outer $border-blurred;
}

.message.note {
    border-left: outer $text-muted;
}

.message.error {
    border-left: outer $error;
}

.message-header {
    width: 1fr;
}

.message .body {
    width: 1fr;
    height: auto;
}

Footer {
    background: $background;
    padding: 0 1;
}

/* ---------- search results ---------- */

.message.search {
    border-left: none;
    padding: 0;
}

.result {
    height: auto;
    margin-top: 1;
}

.result-meta {
    padding-left: 4;
    color: $text-muted;
}

.result-snippet {
    padding-left: 4;
    color: $foreground 85%;
}
